2709c65065a0dbd21014de9bfae0eb41e4681a33e62","field":"website","value":"https://impreg.neak.gov.hu/","variants":["https://impreg.neak.gov.hu/"],"service_ids":["160090002"],"claim_ids":["8211df9e638152f84f37997ebd6431b1655a3a096a4fd7ddee2a3e98294a1ce2"],"association_id":null,"email_validity":null,"role":"source_page","strength":"limited","score":0,"reasons":[],"cautions":["This value is linked to 722 accounts; shared ownership needs review"],"historical_only":false,"purpose_conflict":false,"linked_accounts":722,"independent_source_families":1,"proof_count":2,"proofs":[{"source_url":"https://impreg.neak.gov.hu/","observation_id":"179eb20e0d530fc0e12982d195e01c92821a6aa2fbd4798f4056fa05674b5b90","excerpt":"Felhívjuk figyelmét, hogy az EESZT-hez történő csatlakozás kizárólag akkreditált egészségügyi szoftverrel lehetséges. Javasoljuk, hogy érdeklődjön rendszerszállítójánál az akkreditáció meglétéről, és vegye fel a kapcsolatot az EESZT munkatársaival az alábbi linkre kattintva: Előzetes adatbekérés - https://e-egeszsegugy.gov.hu/elozetes-adatbekeres Amennyiben rendelkezik EESZT akkreditált medikai szoftverrel, az EESZT-hez történő csatlakozást az alábbi linken tudja megkezdeni: EESZT csatlakozás - https://e-egeszsegugy.gov.hu/ekapu Az EESZT-hez történő 2018-as kötelező magánszolgáltatói csatlakozás nem jelenti a Központi Implantátumregiszterbe és a Nemzeti Protézis Regiszterbe történő adatszolgáltatás folyamatának változását, az adatszolgáltatás változatlan formában történik. A Központi Implantátumregiszterbe valamint a Nemzeti Protézis Regiszterbe történő adatszolgáltatási kötelezettség azonban együtt jár azzal, hogy a kapcsolódó ellátási eseményekről az EESZT részére szintén adatszolgáltatást kell teljesíteni: a Központi eseménykatalógus az Egészségügyi dokumentáció nyilvántartás szabályai szerint. Az EESZT-be történő kötelező adatszolgáltatás részleteiről itt talál részletesebb inf","source_date":null,"retrieved_at":"2026-09-14T20:54:52.439000Z","role":"source_page","strength":"limited","reasons":[],"cautions":[],"historical":false},{"source_url":"https://impreg.neak.gov.hu/","observation_id":"179eb20e0d530fc0e12982d195e01c92821a6aa2fbd4798f4056fa05674b5b90","excerpt":"Tisztelt Felhasználó! Üdvözöljük a Központi Implantátumregiszter honlapján! Kérjük, hogy olvassák el a tájékoztatóinkat, melyek a Letölthető anyagok menüpont alatt találhatóak. Tájékoztatjuk a Tisztelt Szolgáltatókat, hogy az egészségügyről szóló 1997. évi CLIV. törvény (Eü. tv.): 101/B és 101/C pontjai alapján az Implantátumregiszterrel kapcsolatban felmerülő esetleges kérdések és észrevételek kezelését az Országos Gyógyszerészeti és Élelmezés-egészségügyi Intézet végzi. (Postacím: 1051 Budapest, Zrínyi utca 3., e-mail: implantatum@ogyei.gov.hu )","source_date":null,"retrieved_at":"2026-09-14T20:54:52.439000Z","role":"source_page","strength":"limited","reasons":[],"cautions":[],"historical":false}],"needs_review":true}],"recommended":{"email":null,"website":null,"telephone":null},"recommendation_reasons":{"email":"No candidate meets the identity and contact-purpose checks","website":"No candidate meets the identity and contact-purpose checks","telephone":"No candidate meets the identity and contact-purpose checks"},"lanes":["shared_email"],"review_sample":false}}
