2c481f62f96c96b7b6a17d1f7ec1fb238a9d648"],"association_id":null,"email_validity":null,"role":"source_page","strength":"limited","score":0,"reasons":[],"cautions":["This value is linked to 722 accounts; shared ownership needs review"],"historical_only":false,"purpose_conflict":false,"linked_accounts":722,"independent_source_families":1,"proof_count":2,"proofs":[{"source_url":"https://impreg.neak.gov.hu/","observation_id":"43903f79c1c14e2adc465fd98d693c70aabbf93311437ccfdba33d92abf3f6a0","excerpt":"Felhívjuk figyelmét, hogy az EESZT-hez történő csatlakozás kizárólag akkreditált egészségügyi szoftverrel lehetséges. Javasoljuk, hogy érdeklődjön rendszerszállítójánál az akkreditáció meglétéről, és vegye fel a kapcsolatot az EESZT munkatársaival az alábbi linkre kattintva: Előzetes adatbekérés - https://e-egeszsegugy.gov.hu/elozetes-adatbekeres Amennyiben rendelkezik EESZT akkreditált medikai szoftverrel, az EESZT-hez történő csatlakozást az alábbi linken tudja megkezdeni: EESZT csatlakozás - https://e-egeszsegugy.gov.hu/ekapu Az EESZT-hez történő 2018-as kötelező magánszolgáltatói csatlakozás nem jelenti a Központi Implantátumregiszterbe és a Nemzeti Protézis Regiszterbe történő adatszolgáltatás folyamatának változását, az adatszolgáltatás változatlan formában történik. A Központi Implantátumregiszterbe valamint a Nemzeti Protézis Regiszterbe történő adatszolgáltatási kötelezettség azonban együtt jár azzal, hogy a kapcsolódó ellátási eseményekről az EESZT részére szintén adatszolgáltatást kell teljesíteni: a Központi eseménykatalógus az Egészségügyi dokumentáció nyilvántartás szabályai szerint. Az EESZT-be történő kötelező adatszolgáltatás részleteiről itt talál részletesebb inf","source_date":null,"retrieved_at":"2026-07-14 20:25:31.841204","role":"source_page","strength":"limited","reasons":[],"cautions":[],"historical":false},{"source_url":"https://impreg.neak.gov.hu/","observation_id":"43903f79c1c14e2adc465fd98d693c70aabbf93311437ccfdba33d92abf3f6a0","excerpt":"Tisztelt Felhasználó! Üdvözöljük a Központi Implantátumregiszter honlapján! Kérjük, hogy olvassák el a tájékoztatóinkat, melyek a Letölthető anyagok menüpont alatt találhatóak. Tájékoztatjuk a Tisztelt Szolgáltatókat, hogy az egészségügyről szóló 1997. évi CLIV. törvény (Eü. tv.): 101/B és 101/C pontjai alapján az Implantátumregiszterrel kapcsolatban felmerülő esetleges kérdések és észrevételek kezelését az Országos Gyógyszerészeti és Élelmezés-egészségügyi Intézet végzi. (Postacím: 1051 Budapest, Zrínyi utca 3., e-mail: implantatum@ogyei.gov.hu )","source_date":null,"retrieved_at":"2026-07-14 20:25:31.841204","role":"source_page","strength":"limited","reasons":[],"cautions":[],"historical":false}],"needs_review":true},{"id":"9911bf47f99584ad42bda22ce80f07708a942ba9f47f8911de6aa0883b146e0f","field":"website","value":"https://www.mfkh.hu/public/editor/BETEGEINKNEK/H%C3%A1ziorvos_Heves%20megye.pdf","variants":["https://www.mfkh.hu/public/editor/BETEGEINKNEK/H%C3%A1ziorvos_Heves%20megye.pdf"],"service_ids":["100095013"],"claim_ids":["3228b917f753d25df5fa38430d2b0ccc8d19293b02b1251b2307b944fb9c0521"],"association_id":null,"email_validity":null,"role":"source_page","strength":"limited","score":0,"reasons":["Recorded doctor name matches","Service town matches","Service address matches"],"cautions":["No bounded retained HTML contact block supports this value","This value is linked to 162 accounts; shared ownership needs review"],"historical_only":false,"purpose_conflict":false,"linked_accounts":162,"independent_source_families":1,"proof_count":2,"proofs":[{"source_url":"https://www.mfkh.hu/public/editor/BETEGEINKNEK/H%C3%A1ziorvos_Heves%20megye.pdf","observation_id":"e21d0c8859ae806da84ed9c8227328d3866ce5900661b4bf6f679d56a4632556","excerpt":"Márkus Margit Bt. 3200 Gyöngyös Dózsa Gy. út 18. (37)313-112\nDr. ","source_date":null,"retrieved_at":"2026-09-14T21:19:06.478037+00:00","role":"source_page","strength":"limited","reasons":["Recorded doctor name matches","Service town matc