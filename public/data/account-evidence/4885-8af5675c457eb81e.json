let/gyermek-haziorvos","evidence_kind":"explicit_candidate; retained_search_result_snippet; source_page_not_verified","identity_basis":"unique_registry_doctor_in_source; location_requires_review","temporal_status":"undated_current_use_not_verified"},{"observation_id":"9e641ddc5d8980afb85a7cf2b0c7ed2b9549e0ad3fc0cfbc4fb33bfffb07589f","source_url":"https://medgo.hu/budapest/xxi-kerulet/gyermek-haziorvos","retrieved_at":"2026-09-14T20:54:52.371000Z","source_stated_date":null,"method":"search_snippet","source_role":"directory","evidence":"orvos Budapest XXI. kerület – Magán és TB rendelés ... Dr. Bátorfi Borbála. Gyermek háziorvos. 1212 ... Tájékozódjon az időpontfoglalás módjáról: telefonon, online vagy személyesen lehet-e bejelentkezni. ... kerület ... https://medgo.hu/budapest/xxi-kerulet/gyermek-haziorvos","evidence_kind":"explicit_candidate","identity_basis":"local_named_practice_context","temporal_status":"undated_current_use_not_verified"}],"attribution":{"version":1,"status":"attribution_unresolved","eligible_for_analytics":false,"scope":"unresolved","service_ids":[],"all_panels_verified":false,"current_use_verified":false,"reasons":[],"proofs":[{"observation_id":"29d56253054879f19c4b8b2ea4fbb6fd2ae7911a02d5c9a93478007c65121944","source_url":"https://medgo.hu/budapest/xxi-kerulet/gyermek-haziorvos","excerpt":"Budapest XXI. kerületben mind TB-finanszírozott, mind magánrendelési lehetőség elérhető. Az állami körzethez tartozó gyermekorvos térítésmentesen látja el a bejelentkezett pácienseket, ugyanakkor a várakozási idő esetenként hosszabb lehet. A magánrendelés ezzel szemben rugalmas időpontfoglalást, rövidebb várakozást és kényelmes helyszínt biztosíthat – az árak rendelőnként eltérnek, ezért érdemes előre tájékozódni.","attributable":false,"scope":"unresolved","reasons":[],"reference":false},{"observation_id":"29d56253054879f19c4b8b2ea4fbb6fd2ae7911a02d5c9a93478007c65121944","source_url":"https://medgo.hu/budapest/xxi-kerulet/gyermek-haziorvos","excerpt":"Tájékozódjon az időpontfoglalás módjáról: telefonon, online vagy személyesen lehet-e bejelentkezni.","attributable":false,"scope":"unresolved","reasons":[],"reference":false},{"observation_id":"29d56253054879f19c4b8b2ea4fbb6fd2ae7911a02d5c9a93478007c65121944","source_url":"https://medgo.hu/budapest/xxi-kerulet/gyermek-haziorvos","excerpt":"Hogyan foglalhatok időpontot gyermek háziorvoshoz Budapest XXI. kerületben? Az időpontfoglalás módja rendelőnként eltérhet: sok helyen lehetőség van online foglalásra a MedGO.hu felületén keresztül, de telefonos és személyes bejelentkezés is elérhető. Érdemes előre tájékozódni a kiválasztott rendelő foglalási rendjéről, hiszen egyes helyeken napokkal előre szükséges időpontot kérni, míg máshol sürgős esetben is fogadnak.","attributable":false,"scope":"unresolved","reasons":[],"reference":false}]}},{"claim_id":"f97dd28056ebb5f880105e0f8f9611eb9dc28dbc519577b0c54b17db975228f5","account_key":"HU:4885","hsz":"010096220","field":"patient_count_clue","value":"000 páciens","review_status":"unreviewed","observations":[{"observation_id":"d1fd8e9c4075ec8ecadd9041405c712acb2676e15d2be176ece4f7279224174f","source_url":"https://budapest-21.doklist.com/hu/s29/","retrieved_at":"2026-09-14T22:41:26.799638+00:00","source_stated_date":null,"method":"vendor_tools","source_role":"directory","evidence":"mutatása\nTovábbi információk a Doklist.com-ról\n×\nKészítse el Doklist.com fiókját\nHavi több mint 160,000 pácienst tud elérni\nIngyenes megjelenés\n...\nRegisztrálok mint*\nRendelő\nOrvos\nElfogadom az\nÁltalános Szerződ","evidence_kind":"count_scope_and_period_need_review; not_account_patient_total","identity_basis":"local_named_practice_context","temporal_status":"undated_current_use_not_verified"}]}],"contact_reconciliation":{"version":1,"groups":[{"id":"bfd360f95d1ce553896d497da019c2ab9b27155e929219766953bc9b67aaa283","field":"website","value":"https://foglaljorvost.hu/haziorvosok/b/","variants":["https://foglaljorvost.hu/haziorvosok/b/"],"service_ids